{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turbo Ogre artifact declaration v1 (Node client subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "channels"],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "string", "pattern": "\\S"},
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "canary": {"$ref": "#/$defs/channel"},
        "stable": {"$ref": "#/$defs/channel"},
        "preview": {"$ref": "#/$defs/channel"}
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$", "not": {"enum": [".", ".."]}}},
        "retain": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
